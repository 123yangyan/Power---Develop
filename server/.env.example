# =============================================================================
# TimedRecorder + 身心看板 环境变量
# 复制为 .env 后修改：cp .env.example .env && nano .env
# =============================================================================
#
# 【最少配置 — 仅身心看板 + Android 同步】
#   API_KEY、POSTGRES_PASSWORD、DATABASE_URL（与密码一致）
#
# 【完整配置 — 再加录音上传 + PG 每日备份到 OSS】
#   OSS_*、DASHSCOPE_API_KEY、ECS 绑定 RAM 角色 TimedRecorderECSRole
#
# =============================================================================

# ---- API 鉴权（看板 / Android / 录音接口共用）----
# 留空则不校验 Bearer Token（生产环境请勿留空）
API_KEY=your-api-key-for-app

# ---- PostgreSQL + TimescaleDB（Docker Compose 必填）----
# POSTGRES_PASSWORD 供 postgres 容器初始化；须与 DATABASE_URL 中密码一致
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://recorder:changeme@postgres:5432/recorder
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Redis（队列，录音 Worker 用；身心看板可保持默认）
REDIS_URL=redis://redis:6379/0

# ---- OSS（PG 备份 scripts/backup-pg.py + 录音上传）----
# OSS_REGION 必须与 ECS 所在地域一致（杭州 ECS → cn-hangzhou）
OSS_REGION=cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_RAM_ROLE_NAME=TimedRecorderECSRole
# 同地域 ECS 建议 true（走内网）；跨地域或本地调试可 false
OSS_INTERNAL_ENDPOINT=true

# ---- 百炼 DashScope（仅云端录音 ASR/LLM；不用录音可留空）----
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ---- 录音处理配置（不用录音可忽略）----
SIGNED_URL_EXPIRES_SECONDS=3600
ASR_MODEL=fun-asr
LLM_MODEL=qwen-plus

# =============================================================================
# 已废弃 — 请勿再使用 SQLite（deploy.sh 会尝试自动改写 DATABASE_URL）
# DATABASE_URL=sqlite:////data/recorder.db
# =============================================================================
